{
  "schemaVersion": 1,
  "id": "io.github.gustavonline.local-ai",
  "name": "Omarchy Model Dock",
  "version": "0.11.0",
  "author": "Gustav Andersen",
  "license": "MIT",
  "description": "Prepare, serve and connect local models with native Omarchy controls and an agent CLI.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Model Dock",
    "description": "Local inference, authenticated endpoints and optional Assistant.",
    "category": "AI",
    "aliases": [
      "model-dock",
      "local-models",
      "local-ai",
      "llama.cpp",
      "inference",
      "assistant"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "localConfigFile": "~/.config/omarchy/local-ai.toml",
      "refreshIntervalSec": 10
    },
    "schema": [
      {
        "key": "localConfigFile",
        "type": "path",
        "label": "Existing runtime profiles",
        "defaultValue": "~/.config/omarchy/local-ai.toml",
        "description": "TOML index of prepared llama.cpp systemd user services."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 10
      }
    ]
  }
}
